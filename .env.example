# Copy to .env (git-ignored) and fill in. Never commit .env.

# TabPFN API key, from https://platform.priorlabs.ai/account/api-keys
# Only needed for live API calls; cached results reproduce without it.
TABPFN_TOKEN=

# Set to 1 to let experiments call the API instead of reading results/ caches.
TABPFN_LIVE=0

# tabpfn-client sends anonymous usage telemetry (PostHog) by default outside CI.
# Uncomment to opt out.
# TABPFN_DISABLE_TELEMETRY=1

# Project author only: also append every billed request to the committed
# results/api_ledger.jsonl (provenance). Leave unset when re-running someone else's repo.
# TABPFN_RECORD_SPEND=1
